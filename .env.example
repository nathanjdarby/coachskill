# Copy to .env.local and fill in. Restart the dev server after changes.

# --- App URL -----------------------------------------------------------------
# Public URL of the site. Used for Stripe redirects and links in emails.
# In dev, match the port the server is actually running on.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Stripe ------------------------------------------------------------------
# Secret key from https://dashboard.stripe.com/apikeys (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=sk_test_
# Signing secret for the /api/stripe-webhook endpoint (whsec_...).
# Locally: `stripe listen --forward-to localhost:3000/api/stripe-webhook`
STRIPE_WEBHOOK_SECRET=
# Optional, legacy: only used when no dated workshop run is published in admin.
# Dated runs charge the deposit set on the run.
STRIPE_PRICE_ID=
# Optional: stored in checkout session metadata and on the seeded workshop.
STRIPE_PRODUCT_ID=
# Optional: product image shown on the Stripe Checkout page.
NEXT_PUBLIC_STRIPE_IMAGE_URL=

# --- Accounts (NextAuth / Auth.js) ------------------------------------------
# Signs login sessions and form tokens. Generate with: openssl rand -base64 32
# (NEXTAUTH_SECRET is also accepted). Admin and client logins live in the
# database — create admins with: npm run admin:create -- you@example.com "Your Name"
AUTH_SECRET=

# --- Email (Resend) ----------------------------------------------------------
# Sends client invites, password resets and portal notifications. Without it,
# emails are printed to the server log and invite links are shown on screen.
RESEND_API_KEY=
# Optional. Must be on a domain verified in Resend.
EMAIL_FROM="Monika at Coach Skill <monika@mail.coachskill.co.uk>"
# Optional: where replies to portal emails should go.
EMAIL_REPLY_TO=

# --- Scheduled jobs ----------------------------------------------------------
# Secret for POST /api/cron (balance emails and reminders). The server's crontab
# calls it every 5 minutes with "Authorization: Bearer <secret>". Generate with:
# openssl rand -hex 32
CRON_SECRET=

# --- n8n webhook -------------------------------------------------------------
# Shared secret for POST /api/webhooks/n8n (Authorization: Bearer <secret>
# or X-Webhook-Secret: <secret>). The endpoint rejects all requests if unset.
N8N_WEBHOOK_SECRET=

# --- Database ----------------------------------------------------------------
# SQLite file path, absolute or relative to the project root. Default: data/app.db
SQLITE_PATH=
# Legacy fallback workshop slug when no dated run is published. Default: value-selling
DEFAULT_WORKSHOP_SLUG=
