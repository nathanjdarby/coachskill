# Copy to .env.local and fill in. Restart the dev server after changes.

# --- App URL -----------------------------------------------------------------
# Public URL of the site. Used for Stripe success/cancel redirects.
# In dev, match the port the server is actually running on.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Stripe ------------------------------------------------------------------
# Secret key from https://dashboard.stripe.com/apikeys (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=sk_test_
# Signing secret for the /api/stripe-webhook endpoint (whsec_...).
# Locally: `stripe listen --forward-to localhost:3000/api/stripe-webhook`
STRIPE_WEBHOOK_SECRET=
# Optional: use an existing Stripe Price. If unset, checkout charges a £25 inline price.
STRIPE_PRICE_ID=
# Optional: stored in checkout session metadata and on the seeded workshop.
STRIPE_PRODUCT_ID=
# Optional: product image shown on the Stripe Checkout page.
NEXT_PUBLIC_STRIPE_IMAGE_URL=

# --- Admin auth (NextAuth / Auth.js) -----------------------------------------
# Generate with: openssl rand -base64 32  (NEXTAUTH_SECRET is also accepted)
AUTH_SECRET=
ADMIN_EMAIL=
# Set ONE of these. The bcrypt hash takes precedence if both are set.
# Generate the hash with the command below. Every $ in it must be escaped as \$,
# otherwise Next.js treats $... as a variable reference and mangles the hash.
# node -e 'console.log(require("bcryptjs").hashSync(process.argv[1], 12).replaceAll("$", "\\$"))' 'your-password'
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# --- n8n webhook -------------------------------------------------------------
# Shared secret for POST /api/webhooks/n8n (Authorization: Bearer <secret>
# or X-Webhook-Secret: <secret>). The endpoint rejects all requests if unset.
N8N_WEBHOOK_SECRET=

# --- Database ----------------------------------------------------------------
# SQLite file path, absolute or relative to the project root. Default: data/app.db
SQLITE_PATH=
# Workshop slug used for Stripe checkouts. Default: value-selling (created by db:seed)
DEFAULT_WORKSHOP_SLUG=
