<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Value Selling Workshop Deposit | Coach Skill</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-deep: #0a0f1a;
      --bg-card: #111827;
      --bg-elevated: #1a2332;
      --accent-blue: #3b82f6;
      --accent-cyan: #22d3ee;
      --accent-gradient: linear-gradient(135deg, #2563eb 0%, #0ea5e9 50%, #06b6d4 100%);
      --glow-blue: rgba(34, 211, 238, 0.4);
      --glow-strong: rgba(59, 130, 246, 0.5);
      --text-primary: #f8fafc;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      --border-subtle: rgba(148, 163, 184, 0.12);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Outfit', -apple-system, sans-serif;
      background: var(--bg-deep);
      color: var(--text-primary);
      line-height: 1.6;
      overflow-x: hidden;
    }

    /* Subtle circuit-inspired background */
    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image: 
        linear-gradient(rgba(59, 130, 246, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(59, 130, 246, 0.03) 1px, transparent 1px);
      background-size: 60px 60px;
      pointer-events: none;
      z-index: 0;
    }

    body::after {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(59, 130, 246, 0.06) 0%, transparent 60%);
      pointer-events: none;
      z-index: 0;
    }

    .container {
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 24px;
      position: relative;
      z-index: 1;
    }

    /* Header */
    header {
      padding: 24px 0;
      position: sticky;
      top: 0;
      background: rgba(10, 15, 26, 0.9);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-subtle);
      z-index: 100;
    }

    header .container {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      height: 40px;
      width: auto;
    }

    /* Hero with Poster */
    .hero {
      padding: 40px 0 80px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 40px;
      align-items: center;
    }

    @media (min-width: 768px) {
      .hero-grid {
        grid-template-columns: 1fr 1fr;
        gap: 48px;
      }
    }

    .poster-frame {
      position: relative;
      border-radius: 20px;
      padding: 8px;
      background: linear-gradient(145deg, rgba(59, 130, 246, 0.2) 0%, rgba(34, 211, 238, 0.1) 50%, rgba(59, 130, 246, 0.15) 100%);
      box-shadow: 
        0 0 40px var(--glow-blue),
        inset 0 0 60px rgba(59, 130, 246, 0.05);
      border: 1px solid rgba(59, 130, 246, 0.25);
    }

    .poster-frame::before {
      content: '';
      position: absolute;
      inset: -2px;
      border-radius: 22px;
      padding: 2px;
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.4), rgba(34, 211, 238, 0.2), rgba(59, 130, 246, 0.3));
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
    }

    .poster-frame img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 14px;
    }

    .hero-content {
      text-align: center;
    }

    @media (min-width: 768px) {
      .hero-content {
        text-align: left;
      }
    }

    .hero-title {
      font-family: 'DM Serif Display', Georgia, serif;
      font-size: clamp(2rem, 4vw, 2.75rem);
      font-weight: 400;
      letter-spacing: -0.02em;
      line-height: 1.2;
      margin-bottom: 16px;
      background: var(--accent-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero .subtitle {
      font-size: 1.25rem;
      color: var(--text-secondary);
      font-weight: 400;
    }


    /* Section flow connector */
    .section-connector {
      height: 1px;
      max-width: 500px;
      margin: 0 auto 64px;
      background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.35), rgba(34, 211, 238, 0.35), rgba(59, 130, 246, 0.35), transparent);
      box-shadow: 0 0 16px var(--glow-blue);
    }

    /* Sales Points Section */
    .section {
      padding: 80px 0;
    }

    .section-title {
      font-family: 'DM Serif Display', Georgia, serif;
      font-size: clamp(2rem, 4vw, 2.75rem);
      font-weight: 400;
      letter-spacing: -0.02em;
      margin-bottom: 48px;
      text-align: center;
    }

    .section-title span {
      background: var(--accent-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .benefits-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 24px;
    }

    .benefit-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 32px;
      position: relative;
      overflow: hidden;
      transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    }

    .benefit-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--accent-gradient);
      opacity: 0;
      transition: opacity 0.2s;
    }

    .benefit-card:hover {
      transform: translateY(-2px);
      border-color: rgba(59, 130, 246, 0.3);
      box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.5), 0 0 30px -10px var(--glow-blue);
    }

    .benefit-card:hover::before {
      opacity: 1;
    }

    .benefit-card .icon {
      width: 48px;
      height: 48px;
      background: var(--accent-gradient);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      margin-bottom: 20px;
    }

    .benefit-card h3 {
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .benefit-card p {
      color: var(--text-secondary);
      font-size: 0.9375rem;
    }

    .highlight-stat {
      color: var(--accent-cyan);
      font-weight: 600;
    }

    /* Coach Section */
    .coach-section {
      background: var(--bg-elevated);
      border-top: 1px solid var(--border-subtle);
      border-bottom: 1px solid var(--border-subtle);
    }

    .coach-grid {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 48px;
      align-items: center;
    }

    @media (max-width: 768px) {
      .coach-grid {
        grid-template-columns: 1fr;
        text-align: center;
      }
    }

    .coach-portrait {
      width: 100%;
      aspect-ratio: 3/4;
      object-fit: cover;
      border-radius: 16px;
      border: 1px solid rgba(59, 130, 246, 0.2);
      box-shadow: 0 0 30px -10px var(--glow-blue);
    }

    .coach-info h2 {
      font-family: 'DM Serif Display', Georgia, serif;
      font-size: 2rem;
      font-weight: 400;
      margin-bottom: 8px;
    }

    .coach-info .title {
      color: var(--accent-cyan);
      font-size: 0.875rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 20px;
    }

    .coach-info p {
      color: var(--text-secondary);
      font-size: 1rem;
      margin-bottom: 16px;
    }

    .coach-info .companies {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 20px;
    }

    .company-tag {
      padding: 6px 12px;
      background: rgba(59, 130, 246, 0.1);
      border-radius: 8px;
      font-size: 0.8125rem;
      color: var(--text-secondary);
    }

    /* Workshop Details */
    .workshop-details {
      display: grid;
      grid-template-columns: 1fr 400px;
      gap: 48px;
      align-items: start;
    }

    @media (max-width: 768px) {
      .workshop-details {
        grid-template-columns: 1fr;
      }
    }

    .workshop-info {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .workshop-item {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      padding: 20px;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
    }

    .workshop-item .check {
      width: 24px;
      height: 24px;
      background: var(--accent-gradient);
      border-radius: 50%;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .workshop-item .check::after {
      content: '✓';
      color: white;
      font-size: 12px;
      font-weight: bold;
    }

    .workshop-item h4 {
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 4px;
    }

    .workshop-item p {
      color: var(--text-secondary);
      font-size: 0.875rem;
    }

    /* Payment Card */
    .payment-card {
      background: linear-gradient(145deg, var(--bg-elevated) 0%, var(--bg-card) 100%);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: 20px;
      padding: 40px;
      position: sticky;
      top: 120px;
      box-shadow: 0 0 40px -15px var(--glow-blue);
    }

    .payment-card h3 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 24px;
      color: var(--text-primary);
    }

    .price-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 0;
      border-bottom: 1px solid var(--border-subtle);
    }

    .price-row:last-of-type {
      border-bottom: none;
      padding-bottom: 0;
    }

    .price-row .label {
      color: var(--text-secondary);
      font-size: 0.9375rem;
    }

    .price-row .amount {
      font-weight: 600;
      font-size: 1.125rem;
    }

    .price-row .amount.highlight {
      color: var(--accent-cyan);
      font-size: 1.25rem;
    }

    .cta {
      display: block;
      width: 100%;
      padding: 18px 32px;
      margin-top: 32px;
      background: var(--accent-gradient);
      color: white;
      font-size: 1rem;
      font-weight: 600;
      font-family: inherit;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      text-align: center;
      text-decoration: none;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .cta:hover {
      transform: translateY(-1px);
      box-shadow: 0 12px 32px -8px rgba(59, 130, 246, 0.5);
    }

    .cta-subtext {
      text-align: center;
      font-size: 0.8125rem;
      color: var(--text-muted);
      margin-top: 16px;
    }

    /* Footer */
    footer {
      padding: 40px 0;
      text-align: center;
      border-top: 1px solid var(--border-subtle);
    }

    footer .logo {
      height: 32px;
      margin-bottom: 16px;
      opacity: 0.8;
    }

    footer p {
      color: var(--text-muted);
      font-size: 0.875rem;
    }

    /* Modal */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(10, 15, 26, 0.85);
      backdrop-filter: blur(8px);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .modal-overlay.is-open {
      display: flex;
    }

    .modal {
      background: var(--bg-card);
      border: 1px solid rgba(59, 130, 246, 0.15);
      border-radius: 16px;
      max-width: 380px;
      width: 100%;
      padding: 36px 32px;
      position: relative;
      box-shadow: 0 0 40px -10px var(--glow-blue);
    }

    .modal-close {
      position: absolute;
      top: 12px;
      right: 12px;
      width: 36px;
      height: 36px;
      border: none;
      background: transparent;
      color: var(--text-muted);
      font-size: 1.5rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
      transition: color 0.2s;
    }

    .modal-close:hover {
      color: var(--text-primary);
    }

    .modal h3 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 4px;
    }

    .modal .modal-subtitle {
      color: var(--text-muted);
      font-size: 0.875rem;
      margin-bottom: 32px;
    }

    .checkout-steps {
      position: relative;
      min-height: 200px;
    }

    .checkout-step {
      display: none;
    }

    .checkout-step.is-active {
      display: block;
    }

    .checkout-form .form-group {
      margin-bottom: 20px;
    }

    .checkout-form label {
      display: block;
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-bottom: 8px;
    }

    .checkout-form input {
      width: 100%;
      padding: 12px 0;
      font-size: 0.9375rem;
      font-family: inherit;
      color: var(--text-primary);
      background: transparent;
      border: none;
      border-bottom: 1px solid var(--border-subtle);
      border-radius: 0;
      transition: border-color 0.2s;
    }

    .checkout-form input::placeholder {
      color: var(--text-muted);
      opacity: 0.7;
    }

    .checkout-form input:focus {
      outline: none;
      border-bottom-color: rgba(59, 130, 246, 0.5);
    }

    .checkout-form .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .checkout-form .form-row .form-group {
      margin-bottom: 20px;
    }

    .step-indicator {
      display: flex;
      gap: 8px;
      margin-bottom: 32px;
    }

    .step-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--border-subtle);
      transition: background 0.2s;
    }

    .step-dot.is-active {
      background: var(--accent-cyan);
      width: 20px;
      border-radius: 3px;
    }

    .checkout-form .btn-row {
      display: flex;
      gap: 12px;
      margin-top: 36px;
    }

    .checkout-form .btn {
      flex: 1;
      padding: 14px;
      font-size: 0.9375rem;
      font-weight: 500;
      font-family: inherit;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      transition: opacity 0.2s;
    }

    .checkout-form .btn:hover {
      opacity: 0.9;
    }

    .checkout-form .btn-primary {
      background: var(--accent-gradient);
      color: white;
    }

    .checkout-form .btn-secondary {
      background: transparent;
      color: var(--text-muted);
    }

    .checkout-form .btn-secondary:hover {
      color: var(--text-secondary);
    }

    .checkout-form .amount-row {
      font-size: 0.875rem;
      color: var(--text-muted);
      margin-bottom: 24px;
    }

    .checkout-form .amount-row strong {
      color: var(--accent-cyan);
    }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <img src="assets/coach-skill-logo.png" alt="Coach Skill" class="logo">
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container">
        <div class="hero-grid">
          <div class="poster-frame">
            <img src="assets/value-selling-poster.png" alt="Value Selling Training — Pitch in a way that can increase your sales by up to 30%">
          </div>
          <div class="hero-content">
            <h1 class="hero-title">Value Selling Training</h1>
            <p class="subtitle">A focused 2.5-hour workshop that transforms how you pitch—from feature-heavy explanations to value-led storytelling that keeps customers engaged.</p>
          </div>
        </div>
      </div>
    </section>

    <div class="section-connector"></div>

    <section class="section">
      <div class="container">
        <h2 class="section-title">What will you <span>achieve</span>?</h2>
        <div class="benefits-grid">
          <article class="benefit-card">
            <div class="icon">↑</div>
            <h3>Pitch for results</h3>
            <p>Pitch in a way that can <span class="highlight-stat">increase your sales by up to 30%</span>.</p>
          </article>
          <article class="benefit-card">
            <div class="icon">◇</div>
            <h3>Clear structure</h3>
            <p>A clear value-selling pitch structure that guides the customer through the conversation.</p>
          </article>
          <article class="benefit-card">
            <div class="icon">◇</div>
            <h3>Engaged customers</h3>
            <p>Keep customers engaged throughout the entire pitch, not just at the start.</p>
          </article>
          <article class="benefit-card">
            <div class="icon">◇</div>
            <h3>Value-led storytelling</h3>
            <p>Replace feature-heavy explanations with value-led storytelling.</p>
          </article>
          <article class="benefit-card">
            <div class="icon">◇</div>
            <h3>Greater confidence</h3>
            <p>Build greater confidence in customer conversations.</p>
          </article>
          <article class="benefit-card">
            <div class="icon">◇</div>
            <h3>Simple language</h3>
            <p>Use simple, human language so customers instantly understand what you're offering.</p>
          </article>
        </div>
      </div>
    </section>

    <div class="section-connector"></div>

    <section class="section coach-section">
      <div class="container">
        <h2 class="section-title">Meet your <span>coach</span></h2>
        <div class="coach-grid">
          <img src="assets/coach-portrait.png" alt="Monika Kozlowska" class="coach-portrait">
          <div class="coach-info">
            <h2>Monika Kozlowska</h2>
            <p class="title">Sales Strategy · Value Selling · Presentations</p>
            <p>An accomplished expert in sales strategy, value-based communication and impactful presentations, with over 18 years' international experience across the UK, Asia and the USA.</p>
            <p>She blends advanced Sales Methodologies, EQ, Value Selling, Storytelling and Objection Handling to deliver dynamic, practical training that builds confidence, trust and helps teams identify customer challenges faster.</p>
            <p>Monika has led enablement programmes for global organisations including Honeywell, Intermec and NICE, where she continues to work today, training hundreds of sales professionals annually—from specialists to senior leaders—and accelerating their time to sell.</p>
            <div class="companies">
              <span class="company-tag">Honeywell</span>
              <span class="company-tag">Intermec</span>
              <span class="company-tag">NICE</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="section-connector"></div>

    <section class="section">
      <div class="container">
        <h2 class="section-title">Workshop <span>details</span></h2>
        <div class="workshop-details">
          <div class="workshop-info">
            <div class="workshop-item">
              <div class="check"></div>
              <div>
                <h4>2.5 hours</h4>
                <p>Focused, practical session designed for maximum impact.</p>
              </div>
            </div>
            <div class="workshop-item">
              <div class="check"></div>
              <div>
                <h4>Small group workshop</h4>
                <p>Maximum 5 participants for personalised attention and deep learning.</p>
              </div>
            </div>
            <div class="workshop-item">
              <div class="check"></div>
              <div>
                <h4>Learn and network</h4>
                <p>Built-in time to learn from others and expand your network.</p>
              </div>
            </div>
            <div class="workshop-item">
              <div class="check"></div>
              <div>
                <h4>Wider Services Portfolio</h4>
                <p>This workshop is part of the Wider Services Portfolio.</p>
              </div>
            </div>
          </div>
          <div class="payment-card">
            <h3>Payment</h3>
            <div class="price-row">
              <span class="label">Deposit now to secure your place</span>
              <span class="amount highlight">£25</span>
            </div>
            <div class="price-row">
              <span class="label">Balance (1 week prior to workshop)</span>
              <span class="amount">£374</span>
            </div>
            <button type="button" class="cta" id="secure-place-btn">Secure your place now for £25</button>
            <p class="cta-subtext">Limited to 5 participants · Reserve your spot today</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <img src="assets/coach-skill-logo.png" alt="Coach Skill" class="logo">
      <p>© Coach Skill · Value Selling Workshop</p>
    </div>
  </footer>

  <div class="modal-overlay" id="checkout-modal" aria-hidden="true">
    <div class="modal">
      <button type="button" class="modal-close" id="modal-close" aria-label="Close">×</button>
      <h3>Secure your place</h3>
      <p class="modal-subtitle">£25 deposit</p>

      <form class="checkout-form" id="checkout-form">
        <div class="step-indicator">
          <span class="step-dot is-active" data-step="1"></span>
          <span class="step-dot" data-step="2"></span>
        </div>

        <div class="checkout-steps">
          <div class="checkout-step is-active" data-step="1">
            <div class="form-group">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" placeholder="Jane Smith" required>
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" placeholder="jane@company.com" required>
            </div>
            <button type="button" class="btn btn-primary" id="step-next">Continue</button>
          </div>

          <div class="checkout-step" data-step="2">
            <div class="amount-row">Total <strong>£25</strong></div>
            <div class="form-group">
              <label for="card-number">Card number</label>
              <input type="text" id="card-number" name="cardNumber" placeholder="4242 4242 4242 4242" maxlength="19">
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="expiry">Expiry</label>
                <input type="text" id="expiry" name="expiry" placeholder="MM / YY" maxlength="7">
              </div>
              <div class="form-group">
                <label for="cvc">CVC</label>
                <input type="text" id="cvc" name="cvc" placeholder="123" maxlength="4">
              </div>
            </div>
            <div class="btn-row">
              <button type="button" class="btn btn-secondary" id="step-back">Back</button>
              <button type="submit" class="btn btn-primary">Pay £25</button>
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>

  <script>
    const modal = document.getElementById('checkout-modal');
    const openBtn = document.getElementById('secure-place-btn');
    const closeBtn = document.getElementById('modal-close');
    const form = document.getElementById('checkout-form');
    const steps = document.querySelectorAll('.checkout-step');
    const dots = document.querySelectorAll('.step-dot');

    function goToStep(step) {
      steps.forEach(s => s.classList.toggle('is-active', +s.dataset.step === step));
      dots.forEach(d => d.classList.toggle('is-active', +d.dataset.step === step));
    }

    function resetCheckout() {
      goToStep(1);
      form.reset();
    }

    function openModal() {
      resetCheckout();
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    openBtn.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

    document.getElementById('step-next').addEventListener('click', () => {
      const name = document.getElementById('name').value.trim();
      const email = document.getElementById('email').value;
      if (!name || !email) return;
      goToStep(2);
    });

    document.getElementById('step-back').addEventListener('click', () => goToStep(1));

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Mockup form — Stripe integration will process payment.');
    });

    document.getElementById('card-number').addEventListener('input', (e) => {
      let v = e.target.value.replace(/\s/g, '').replace(/(\d{4})/g, '$1 ').trim();
      e.target.value = v;
    });

    document.getElementById('expiry').addEventListener('input', (e) => {
      let v = e.target.value.replace(/\D/g, '');
      if (v.length >= 2) v = v.slice(0, 2) + ' / ' + v.slice(2, 4);
      e.target.value = v;
    });

    document.getElementById('cvc').addEventListener('input', (e) => {
      e.target.value = e.target.value.replace(/\D/g, '');
    });
  </script>
</body>
</html>
